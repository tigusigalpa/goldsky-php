{
    "name": "tigusigalpa/goldsky-php",
    "description": "PHP/Laravel SDK for the Goldsky REST control plane and the Subgraph GraphQL and Edge RPC data planes. Built against Goldsky REST API v1.2.0 (40 operations).",
    "type": "library",
    "license": "MIT",
    "keywords": ["goldsky", "sdk", "api", "rest", "graphql", "json-rpc", "edge", "subgraph", "pipeline", "blockchain", "laravel"],
    "authors": [
        {"name": "Igor Sazonov", "email": "sovletig@gmail.com", "homepage": "https://github.com/tigusigalpa"}
    ],
    "require": {
        "php": "^8.1",
        "guzzlehttp/guzzle": "^7.8",
        "psr/log": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0|^11.0"
    },
    "suggest": {
        "illuminate/support": "For Laravel service provider and facade integration (^10.0|^11.0|^12.0|^13.0)"
    },
    "autoload": {
        "psr-4": {"Tigusigalpa\\Goldsky\\": "src/"}
    },
    "autoload-dev": {
        "psr-4": {"Tigusigalpa\\Goldsky\\Tests\\": "tests/"}
    },
    "extra": {
        "laravel": {
            "providers": ["Tigusigalpa\\Goldsky\\Laravel\\GoldskyServiceProvider"],
            "aliases": {"Goldsky": "Tigusigalpa\\Goldsky\\Laravel\\Facades\\Goldsky"}
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}